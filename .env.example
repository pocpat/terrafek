# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: The Gemini model to use for the AI mentor.
# Optional — defaults to "gemini-2.5-flash" if not set.
# Examples: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL="gemini-2.5-flash"

# AI_RATE_LIMIT: Max AI mentor requests per minute per IP.
# Optional — defaults to 10 if not set.
AI_RATE_LIMIT=10

# CORS_ORIGINS: Comma-separated list of allowed origins for CORS.
# Optional — defaults to localhost:3000 and localhost:5173 in dev.
# Set to your production URL(s) if deploying frontend separately from API.
# Example: https://terrafek.example.com,https://staging.terrafek.example.com
# CORS_ORIGINS=""

# PORT: The port the server listens on.
# Optional — defaults to 3000.
# PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"